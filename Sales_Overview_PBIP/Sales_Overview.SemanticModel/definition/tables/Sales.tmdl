		summarizeBy: none
		sourceColumn: UnitPrice

		annotation SummarizationSetBy = Automatic

	column DiscountRate
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 83a41296-9493-5a43-962d-59a8404ede15
		summarizeBy: none
		sourceColumn: DiscountRate

		annotation SummarizationSetBy = Automatic

	column Sales
		dataType: decimal
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		lineageTag: 4a8752fd-5c1d-51eb-942a-dfd3a865c7b6
		summarizeBy: sum
		sourceColumn: Sales

		annotation SummarizationSetBy = Automatic

	column Cost
		dataType: decimal
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		lineageTag: 228edeb5-dc99-5872-8713-845bd3e4576d
		summarizeBy: sum
		sourceColumn: Cost

		annotation SummarizationSetBy = Automatic

	column Profit
		dataType: decimal
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		lineageTag: 1fa81358-dcd5-5f86-8185-fdbce50e3a0e
		summarizeBy: sum
		sourceColumn: Profit

		annotation SummarizationSetBy = Automatic

	column SalesChannel
		dataType: string
		lineageTag: 37e478db-9939-5ac1-bf7a-f08917526bd9
		summarizeBy: none
