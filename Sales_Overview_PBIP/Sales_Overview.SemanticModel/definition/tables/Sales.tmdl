		annotation SummarizationSetBy = Automatic

	column ProfitMargin
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 414360f2-7d45-5cc2-94b9-4b8d75773b9a
		summarizeBy: none
		sourceColumn: ProfitMargin

		annotation SummarizationSetBy = Automatic

	partition Sales = m
		mode: import
		source =
				let
				    BasePath = if Text.EndsWith(DataFolder, "\") then DataFolder else DataFolder & "\",
				    Source = Csv.Document(
				        File.Contents(BasePath & "Sales.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(
				        Headers,
				        {
				            {"OrderID", type text},
				            {"OrderDate", type date},
				            {"ProductID", type text},
				            {"CustomerID", type text},
				            {"Quantity", Int64.Type},
				            {"UnitPrice", Currency.Type},
				            {"DiscountRate", Percentage.Type},
				            {"Sales", Currency.Type},
				            {"Cost", Currency.Type},
				            {"Profit", Currency.Type},
				            {"SalesChannel", type text},
				            {"ProfitMargin", Percentage.Type}
				        },
				        "en-US"
				    )
				in
				    Types

	annotation PBI_ResultType = Table

