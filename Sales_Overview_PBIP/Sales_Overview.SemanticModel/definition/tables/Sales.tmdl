table Sales
	lineageTag: 4773091e-af8c-564a-b2a1-0c2f10b664e2

	/// Umsatz (Summe Sales[Sales])
	measure 'Total Sales' = SUM(Sales[Sales])
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Sales
		lineageTag: 61c4c64b-f5cc-5405-8a47-68a5f6fbe749

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Gewinn (Summe Sales[Profit])
	measure 'Total Profit' = SUM(Sales[Profit])
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Sales
		lineageTag: e38c6794-01f2-560e-9212-ad5194c7e28a

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Kosten (Summe Sales[Cost])
	measure 'Total Cost' = SUM(Sales[Cost])
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Sales
		lineageTag: bcb1add8-cf54-516f-9644-9d711cda8932

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Anzahl eindeutiger Bestellungen
	measure 'Total Orders' = DISTINCTCOUNT(Sales[OrderID])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 3838229f-dc55-57bd-93df-4826b73799ef

	/// Verkaufte Menge
	measure 'Total Quantity' = SUM(Sales[Quantity])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 76c89101-b3e4-5aca-a35e-3bda5053f625

	/// Anzahl Kunden mit Umsatz
	measure 'Total Customers' = DISTINCTCOUNT(Sales[CustomerID])
		formatString: #,0
		displayFolder: Counts
		lineageTag: a50ebe1e-87ad-5896-b0fa-0b2d650b0607

	/// Umsatz je Bestellung
	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders], 0)
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Ratios
		lineageTag: aceaf565-d9a7-5c3b-b2b9-8c34fbd63aa5

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Gewinnmarge = Gewinn / Umsatz (nicht Durchschnitt der Zeilenmargen)
	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ratios
		lineageTag: 9d0028a1-9962-5b23-813b-1b7f4b231341

	/// Umsatz im Vormonat
	measure 'Sales Previous Month' =
			CALCULATE(
			    [Total Sales],
			    DATEADD('Calendar'[Date], -1, MONTH)
			)
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Time Intelligence
		lineageTag: 4f551c36-e179-5195-863b-b844a4129b44

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Veränderung zum Vormonat
	measure 'Sales MoM Change %' = DIVIDE([Total Sales] - [Sales Previous Month], [Sales Previous Month], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 2bcb7712-e911-5e1c-828a-6256f60602b1

	/// Umsatz je Kunde mit Umsatz
	measure 'Sales per Customer' = DIVIDE([Total Sales], [Total Customers], 0)
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Ratios
		lineageTag: b561ce20-3afb-53ec-afc1-c5665f2fb802

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

